<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo displayName="@string/extension_name" icon="@drawable/ic_kghost" id="kghost" scansDevices="false" mapLayer="true" fitFile="false">
    <DataType description="@string/gap_graphic_description" displayName="@string/gap_graphic_name" graphical="true" icon="@drawable/ic_kghost" typeId="kghost-gap" />
    <DataType description="@string/gap_numeric_description" displayName="@string/gap_numeric_name" graphical="true" icon="@drawable/ic_kghost" typeId="kghost-gap-num" />
    <!-- Stream-only (non-graphical) gap values: rendered natively by the Karoo as plain numeric
