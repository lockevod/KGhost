    <DataType description="@string/gap_time_stream_description" displayName="@string/gap_time_stream_name" graphical="false" icon="@drawable/ic_kghost" typeId="kghost-gap-time" />
    <DataType description="@string/gap_dist_stream_description" displayName="@string/gap_dist_stream_name" graphical="false" icon="@drawable/ic_kghost" typeId="kghost-gap-dist" />
</ExtensionInfo>
